{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://raw.githubusercontent.com/adevcorn/basalt-registry/main/schema.json",
 "title": "Basalt Plugin Registry Index",
 "type": "object",
 "required": [
  "version",
  "updated_at",
  "plugins"
 ],
 "properties": {
  "version": {
   "type": "string",
   "description": "Schema version of this index file."
  },
  "updated_at": {
   "type": "string",
   "format": "date-time",
   "description": "ISO-8601 timestamp of the last index update."
  },
  "plugins": {
   "type": "array",
   "items": {
    "$ref": "#/definitions/Plugin"
   },
   "description": "Legacy flat list: providers, parsers, agents, and other standalone plugins."
  },
  "packs": {
   "type": "array",
   "description": "Language packs (parser + parser-derived facts). Separate so clients predating language-pack support ignore them.",
   "items": {
    "$ref": "#/definitions/Plugin"
   }
  },
  "presets": {
   "type": "array",
   "description": "Curated install groups pinning language packs and providers. Separate so older clients ignore them.",
   "items": {
    "$ref": "#/definitions/Plugin"
   }
  }
 },
 "definitions": {
  "Plugin": {
   "type": "object",
   "required": [
    "name",
    "version",
    "description",
    "author",
    "tags",
    "capabilities",
    "hook_flags",
    "file_globs"
   ],
   "properties": {
    "name": {
     "type": "string",
     "pattern": "^[a-z0-9-]+$",
     "description": "Unique plugin identifier (lowercase, hyphens allowed)."
    },
    "version": {
     "type": "string",
     "pattern": "^\\d+\\.\\d+\\.\\d+$",
     "description": "Semantic version string."
    },
    "description": {
     "type": "string",
     "maxLength": 280
    },
    "author": {
     "type": "string"
    },
    "homepage": {
     "type": "string",
     "format": "uri"
    },
    "tags": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    },
    "capabilities": {
     "type": "array",
     "items": {
      "type": "string",
      "enum": [
       "DIAGNOSTICS",
       "PROJECT_MODEL",
       "HOVER",
       "AGENT_LAUNCHER",
       "RETRIEVAL",
       "REVIEW_ACTIONS",
       "API_INDEX",
       "SYNTAX_PARSER",
       "SEMANTIC_FACTS",
       "BUILD_SYSTEM",
       "TEST_RUNNER",
       "TIER0",
       "SWARM_STRATEGY",
       "SHADOW_EXCLUDES",
       "SHADOW_SYMLINKS"
      ]
     }
    },
    "hook_flags": {
     "type": "integer",
     "minimum": 0,
     "description": "Bitmask of hooks this plugin registers."
    },
    "file_globs": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    },
    "download_url": {
     "type": "string",
     "format": "uri",
     "description": "Direct URL to the .wasm plugin binary (legacy single-artifact entries)."
    },
    "parser_filename": {
     "type": "string",
     "description": "Filename stem used for the tree-sitter grammar file (SYNTAX_PARSER plugins only)."
    },
    "kind": {
     "type": "string",
     "enum": [
      "provider",
      "language-pack",
      "preset"
     ],
     "default": "provider",
     "description": "Entry type. Providers are leaf plugins; language packs bundle parser + facts; presets pin install groups."
    },
    "artifacts": {
     "type": "array",
     "description": "Artifacts installed by a language pack (or a multi-file provider).",
     "items": {
      "$ref": "#/definitions/Artifact"
     }
    },
    "members": {
     "type": "array",
     "description": "Members installed by a preset. Presets carry no code.",
     "items": {
      "$ref": "#/definitions/Member"
     }
    },
    "markers": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Ecosystem files (globs) that trigger auto-install of a preset."
    },
    "language_globs": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Language files that must also be present for auto-install (unless require_language_files is false)."
    },
    "require_language_files": {
     "type": "boolean",
     "default": true,
     "description": "When true (default), a marker match also needs at least one language_globs match."
    },
    "aliases": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Alternate names accepted when resolving preset members."
    },
    "supersedes": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Legacy plugin names replaced by this entry."
    }
   },
   "anyOf": [
    {
     "required": [
      "download_url"
     ]
    },
    {
     "required": [
      "artifacts"
     ]
    },
    {
     "required": [
      "members"
     ]
    }
   ]
  },
  "Artifact": {
   "type": "object",
   "required": [
    "kind",
    "artifact",
    "download_url"
   ],
   "properties": {
    "kind": {
     "type": "string",
     "enum": [
      "parser",
      "plugin"
     ]
    },
    "artifact": {
     "type": "string",
     "description": "Release asset filename, e.g. cs.wasm."
    },
    "download_url": {
     "type": "string",
     "format": "uri"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[a-fA-F0-9]{64}$",
     "description": "Optional SHA-256 of the artifact."
    },
    "install_as": {
     "type": "string",
     "description": "Installed filename stem (parser stem for parsers)."
    },
    "parser_filename": {
     "type": "string",
     "description": "Canonical parser filename stem, e.g. cs."
    },
    "target": {
     "type": "string",
     "enum": [
      "wasm32-wasip1",
      "wasm32-unknown-unknown"
     ]
    }
   }
  },
  "Member": {
   "type": "object",
   "required": [
    "name"
   ],
   "properties": {
    "name": {
     "type": "string",
     "description": "Registry entry name (pack or provider)."
    },
    "version": {
     "type": "string",
     "description": "Optional version requirement/pin."
    },
    "required": {
     "type": "boolean",
     "default": false
    },
    "recommended": {
     "type": "boolean",
     "default": false
    }
   }
  }
 }
}
